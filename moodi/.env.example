# Local development backend origin used by the Vite same-origin proxy.
# Do not include a trailing slash.
VITE_BACKEND_ORIGIN=http://localhost:8080

# Browser-facing base path. Keep `/` in local development and Vercel so the
# browser always calls the same origin. Vite proxies locally; Vercel uses vercel.json rewrites.
VITE_API_BASE_URL=/

# Google Identity Services client ID used by the backend Google credential flow.
# VITE_GOOGLE_CLIENT_ID=
