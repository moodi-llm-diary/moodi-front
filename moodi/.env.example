# Local development backend origin used by the Vite same-origin proxy.
# Do not include a trailing slash.
VITE_BACKEND_ORIGIN=http://localhost:8080

# Browser-facing base path. Keep `/` in local development and Vercel so the
# browser always calls the same origin. Vite proxies locally; Vercel uses api/[...path].ts.
VITE_API_BASE_URL=/

# Vercel server-only proxy target. Configure this in the Vercel dashboard as a
# non-VITE environment variable; do not expose the backend origin to browser code.
# MOODI_BACKEND_ORIGIN=https://api.example.com

# Google Identity Services client ID used by the backend Google credential flow.
# VITE_GOOGLE_CLIENT_ID=
