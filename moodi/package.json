{
  "name": "moodi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:e2e:before": "set MOODI_SCREENSHOT_STAGE=before&& playwright test tests/e2e/moodi-visual.spec.ts",
    "test:e2e:iteration": "npm run test:e2e:iteration-1",
    "test:e2e:iteration-1": "set MOODI_SCREENSHOT_STAGE=iteration-1&& playwright test tests/e2e/moodi-visual.spec.ts",
    "test:e2e:iteration-2": "set MOODI_SCREENSHOT_STAGE=iteration-2&& playwright test tests/e2e/moodi-visual.spec.ts",
    "test:e2e:visual": "playwright test tests/e2e/moodi-visual.spec.ts",
    "test:e2e:mobile-ai": "playwright test tests/e2e/moodi-mobile-ai.spec.ts",
    "test:e2e:mobile-ai:iteration-1": "set MOODI_MOBILE_AI_STAGE=iteration-1&& playwright test tests/e2e/moodi-mobile-ai.spec.ts",
    "test:e2e:mobile-ai:iteration-2": "set MOODI_MOBILE_AI_STAGE=iteration-2&& playwright test tests/e2e/moodi-mobile-ai.spec.ts",
    "test:e2e:mobile-ai:final": "set MOODI_MOBILE_AI_STAGE=&& playwright test tests/e2e/moodi-mobile-ai.spec.ts",
    "test:e2e:main-area:iteration-1": "set MOODI_SCREENSHOT_STAGE=main-area-iteration-1&& playwright test tests/e2e/moodi-visual.spec.ts --project=desktop-chrome --project=desktop-chromium",
    "test:e2e:main-area:iteration-2": "set MOODI_SCREENSHOT_STAGE=main-area-iteration-2&& playwright test tests/e2e/moodi-visual.spec.ts --project=desktop-chrome --project=desktop-chromium",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "^3.27.4",
    "@tiptap/extension-link": "^3.27.4",
    "@tiptap/extension-placeholder": "^3.27.4",
    "@tiptap/extension-task-item": "^3.27.4",
    "@tiptap/extension-task-list": "^3.27.4",
    "@tiptap/extension-underline": "^3.27.4",
    "@tiptap/pm": "^3.27.4",
    "@tiptap/react": "^3.27.4",
    "@tiptap/starter-kit": "^3.27.4",
    "lucide-react": "^1.18.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
